CPP ?= g++
TARGET = gravebot_mm
ARCHFLAG = i686
BASEFLAGS = -Dstricmp=strcasecmp -Dstrcmpi=strcasecmp -DMETAMOD_BUILD
OPTFLAGS = 
ifeq "$(CFG)" ""
CFG=Release_Metamod
endif
OUTDIR = $(CFG)
CPPFLAGS = ${BASEFLAGS} ${OPTFLAGS} -march=${ARCHFLAG} -mtune=generic -msse2 -O2 -m32 -mfpmath=sse -finline-functions -pipe -w -I"../common" -I"../dlls" -I"../engine" -I"../pm_shared" -I"../metamod" 
LDFLAGS = -Wl,--no-undefined -Wl,-z,defs

SRC = 	bot.cpp \
	bot_client.cpp \
	bot_combat.cpp \
	bot_navigate.cpp \
	bot_prophunt.cpp \
	bot_shidden.cpp \
	bot_start.cpp \
	bot_weapons.cpp \
	bot_weapons_hldm.cpp \
	bot_weapons_si.cpp \
	dll.cpp \
	engine.cpp \
	h_export.cpp \
	util.cpp \
	waypoint.cpp

OBJ = $(patsubst %.cpp,$(OUTDIR)/%.o,$(SRC))

${OUTDIR}/${TARGET}.so: ${OBJ}
	${CPP} -m32 -fPIC -shared -static ${LDFLAGS} -o $@ ${OBJ} -Xlinker -Map -Xlinker ${OUTDIR}/${TARGET}.map -ldl
	strip -s $@

${OUTDIR}:
	mkdir -p ${OUTDIR}

${OUTDIR}/%.o: %.cpp | ${OUTDIR}
	${CPP} ${CPPFLAGS} -c $< -o $@

clean:
	rm -f *.o
	rm -f ${OUTDIR}/*.o
	rm -f ${OUTDIR}/*.map
	rm -f ${OUTDIR}/${TARGET}.so

distclean:
	rm -rf ${OUTDIR}

.PHONY: clean distclean