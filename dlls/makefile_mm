CPP ?= g++
TARGET = gravebot_mm
ARCHFLAG = i686
BASEFLAGS = -Dstricmp=strcasecmp -Dstrcmpi=strcasecmp -DMETAMOD_BUILD
OPTFLAGS = 
ifeq "$(CFG)" ""
CFG=Release_Metamod
endif
OUTDIR = $(CFG)
CPPFLAGS = ${BASEFLAGS} ${OPTFLAGS} -march=${ARCHFLAG} -mtune=generic -msse2 -O2 -m32 -mfpmath=sse -finline-functions -pipe -w -I"../common" -I"../dlls" -I"../engine" -I"../pm_shared" -I"../metamod" 
LDFLAGS = -Wl,--no-undefined

OBJ = 	bot.o \
	bot_client.o \
	bot_combat.o \
	bot_navigate.o \
	bot_prophunt.o \
	bot_shidden.o \
	bot_start.o \
	bot_weapons.o \
	bot_weapons_hldm.o \
	bot_weapons_si.o \
	dll.o \
	engine.o \
	h_export.o \
	util.o \
	waypoint.o

${TARGET}.so: ${OBJ}
	${CPP} -fPIC -shared -static ${LDFLAGS} -o $@ ${OBJ} -Xlinker -Map -Xlinker ${TARGET}.map -ldl
	strip -s ${TARGET}.so 
	mv *.o ${OUTDIR}
	mv *.map ${OUTDIR}
	mv $@ ${OUTDIR}

clean:
	rm -f ${OUTDIR}/*.o
	rm -f ${OUTDIR}/*.map

distclean:
	rm -rf ${OUTDIR}
	mkdir ${OUTDIR}	

%.o:	%.cpp
	${CPP} ${CPPFLAGS} -c $< -o $@

%.o:	%.c
	${CPP} ${CPPFLAGS} -c $< -o $@